  "text": "class Car: def __init__(self, color, speed): # init 객체를만들때자동으로호출됨 self.color = color self.speed = speed # methods def upSpeed(self, amt): self.speed += amt def downSpeed(self, amt): self.speed -= amt def _ repr__(self): # stringS AHS. return self.color def __add__(self, other): # 연산자 OH Ba + 사용할때동작 # 더하기를하면실제로는이게호출됨 return self.speed + other.speed def __sub__(self, other): # 연산자 SHED - 연산자를사용할때동작 return self.speed - other.speed def other): # 연산자 < AAAS 사용할때동작 return self.speed < other.speed = Car(\"red\", 10) car2 = Car(\"blue\", 20) carl<car2 #True car1==car2 #False car1-car2 #-10 car1.__add__(car2) #30 이렇게 AS 사용하는것도가능. print(car1) #red _repr_9| 호출됨 class Score: def __init__(self, name, kor, eng, math): self.name = name self.kor = kor self.eng = eng self.math = math def get_avg(self): return (self.kor + self.eng + self.math) / 3 def __repr__(self): return str(self.get_avg()) def __add__(self, other): return self.get_avg() + other.get_avg() def other): return self.get_avg() < other.get_avg() - 35 -",
